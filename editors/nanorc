# colorleaf: nano follows foot's terminal palette (matugen-driven 16 colors)
# UI colors use NUMERIC cterm values so text stays light & readable against
# the dark background, exactly like vim/nvim/htop.
set tabsize 4
set tabstospaces
set autoindent
set nohelp
set linenumbers
set constantshow
set positionlog
set historylog
set minibar
set softwrap

# toast/error: vivid red against dark bg
set errorcolor brightwhite,red
# function/help text: light readable gray
set functioncolor brightwhite
# line numbers: mid-light gray, clearly distinct from bg
set numbercolor brightblack
# prompt bar text: light
set promptcolor brightwhite,black
# selected text (in bar): light on dark
set selectedcolor white,black
# status bar: light text on dark
set statuscolor brightwhite,black
# title bar: light text on black
set titlecolor brightwhite,black

include "/usr/share/nano/sh.nanorc"
include "/usr/share/nano/c.nanorc"
include "/usr/share/nano/python.nanorc"
include "/usr/share/nano/json.nanorc"
include "/usr/share/nano/yaml.nanorc"
include "/usr/share/nano/html.nanorc"
include "/usr/share/nano/css.nanorc"
include "/usr/share/nano/js.nanorc"
include "/usr/share/nano/rust.nanorc"
include "/usr/share/nano/go.nanorc"
include "/usr/share/nano/makefile.nanorc"
include "/usr/share/nano/default.nanorc"
