#!/usr/bin/env python3
"""rice-paper — lightweight wallpaper picker (thumbnail grid).

Renders pre-generated thumbnails (fast + low RAM), applies the chosen one
via rice-wallpaper (swaybg + matugen), so the whole rice follows the image.
"""
import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gtk  # noqa: E402

WALL_DIR = Path.home() / "Pictures" / "_wallpapers"
THUMB_DIR = Path.home() / ".cache" / "rice" / "thumbs"
EXT = (".png", ".jpg", ".jpeg", ".webp", ".bmp")
CELL = 148  # thumbnail cell size (px)
COLS = 6


def collect():
    walls, thumbs = [], []
    for f in sorted(WALL_DIR.iterdir()):
        if f.is_file() and f.suffix.lower() in EXT:
            t = THUMB_DIR / (f.stem + ".jpg")
            walls.append(f)
            thumbs.append(t if t.exists() else None)
    return walls, thumbs


def apply(path):
    try:
        subprocess.run(["rice-wallpaper", str(path)], check=False)
    except FileNotFoundError:
        subprocess.Popen(
            [f"{Path.home()}/.local/bin/rice-wallpaper", str(path)]
        )


class Picker(Gtk.Window):
    def __init__(self, walls, thumbs):
        super().__init__(title="rice · wallpaper")
        self.set_default_size(COLS * CELL, 620)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.apply_css()
        self.add_cells(walls, thumbs)

    def apply_css(self):
        css = b"""
        window { background-color: #1d1a20; }
        .cell { background-color: #30282b; border: 2px solid #1d1a20; }
        .cell:hover { background-color: #3b3236; border: 2px solid #8ed5ff; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    def add_cells(self, walls, thumbs):
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, margin=8)
        grid.set_halign(Gtk.Align.START)
        grid.set_valign(Gtk.Align.START)

        for i, (w, t) in enumerate(zip(walls, thumbs)):
            img = Gtk.Image()
            pix = None
            if t:
                try:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_size(str(t), CELL, CELL)
                except Exception:
                    pix = None
            if pix is None:
                pix = GdkPixbuf.Pixbuf.new(
                    GdkPixbuf.Colorspace.RGB, False, 8, CELL, CELL
                )
                pix.fill(0x30282b)
            img.set_from_pixbuf(pix)

            btn = Gtk.Button(image=img)
            btn.get_style_context().add_class("cell")
            btn.set_tooltip_text(w.name)
            btn.connect("clicked", self.on_click, w)
            grid.attach(btn, i % COLS, i // COLS, 1, 1)

        scroller.add(grid)
        self.add(scroller)

    def on_click(self, _btn, path):
        apply(path)
        self.close()


def main():
    walls, thumbs = collect()
    if not walls:
        print(f"no wallpapers in {WALL_DIR}", file=sys.stderr)
        return 1
    win = Picker(walls, thumbs)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
