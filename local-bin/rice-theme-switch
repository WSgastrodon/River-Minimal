#!/usr/bin/env bash
# rice-theme-switch — no more preset colour themes.
# Everything is wallpaper-driven (matugen). This script now routes to the
# wallpaper picker / cycler so old bindings keep working:
#   menu|pick   -> rice-paper      (thumbnail picker)
#   next|cycle  -> rice-wallpaper next
#   random      -> rice-wallpaper random
set -u
case "${1:-menu}" in
    menu|pick|"") rice-paper ;;
    next|cycle)   rice-wallpaper next ;;
    random)       rice-wallpaper random ;;
    *)            rice-paper ;;
esac
