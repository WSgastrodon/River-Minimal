#!/usr/bin/env python3
"""rice-thumbs — pre-generate small wallpaper thumbnails for the rice picker.

Fast + low-RAM: thumbnails are generated once and cached, so the GTK picker
only loads small images instead of full-resolution wallpapers.
"""
import os
import sys
from pathlib import Path

WALL_DIR = Path.home() / "Pictures" / "_wallpapers"
CACHE = Path.home() / ".cache" / "rice" / "thumbs"
THUMB = 240  # thumb long-edge px

EXT = (".png", ".jpg", ".jpeg", ".webp", ".bmp")


def collect():
    imgs = []
    if WALL_DIR.is_dir():
        for f in sorted(WALL_DIR.iterdir()):
            if f.is_file() and f.suffix.lower() in EXT:
                imgs.append(f)
    return imgs


def main():
    CACHE.mkdir(parents=True, exist_ok=True)
    imgs = collect()
    if not imgs:
        print(f"no wallpapers under {WALL_DIR}", file=sys.stderr)
        return 1

    try:
        from PIL import Image
    except ImportError:
        print("PIL not available", file=sys.stderr)
        return 1

    for ipath in imgs:
        out = CACHE / (ipath.stem + ".jpg")
        if out.exists() and out.stat().st_mtime >= ipath.stat().st_mtime:
            continue
        try:
            with Image.open(ipath) as im:
                im = im.convert("RGB")
                im.thumbnail((THUMB, THUMB))
                im.save(out, "JPEG", quality=82)
        except Exception as exc:  # skip unreadable
            print(f"skip {ipath.name}: {exc}", file=sys.stderr)
            continue
    return 0


if __name__ == "__main__":
    sys.exit(main())
