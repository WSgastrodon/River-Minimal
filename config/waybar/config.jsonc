{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "height": 26,
    "margin-top": 6,
    "margin-bottom": 0,

    "modules-left": [],
    "modules-center": [
        "clock",
        "river/tags",       // REPLACED niri/workspaces
        "pulseaudio",
        "network",
        "custom/power",     // REMOVED bluetooth
        "battery"
    ],
    "modules-right": [],

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": { "mode": "month" }
    },

    "river/tags": {
        "num-tags": 9,
        "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
    },

    "pulseaudio": {
        "format": "{volume}%    ",
        "format-muted": "{volume}%    ",
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip": false
    },

    "network": {
        "interval": 10,
        "format-wifi": "{essid}    ",
        "format-ethernet": "{ifname}    ",
        "format-disconnected": "Offline    ",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "No connection",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on"
    },

    "custom/power": {
        "format": "  ",
        "tooltip": "Power menu",
        "on-click": "wlogout"  // Triggers your native wlogout layout directly
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 60,
        "states": { "good": 80, "warning": 30, "critical": 15 },
        "format": "{capacity}",
        "format-charging": "{capacity}",
        "format-plugged": "{capacity}",
        "tooltip-format": "{capacity}% · {timeTo}"
    }
}
