#!/usr/bin/env bash
# River configuration file translated from Niri Rice configs
set -euo pipefail

# Set your primary Modifier key to Super (Windows Key)
MOD="Super"

# ---------- Input Settings ----------
riverctl input "pointer-*" tap enabled
riverctl input "pointer-*" natural-scroll enabled
riverctl input "keyboard-*" repeat-rate 25
riverctl input "keyboard-*" repeat-delay 600

# ---------- Layout & Window Aesthetics ----------
riverctl set-window-padding 9  # Gaps

# Configure focused and unfocused window borders
riverctl border-color-focused "0x95cdf7ff"    # Primary Accent Color
riverctl border-color-unfocused "0x313539ff"  # Soft Dark Base Color
riverctl border-width 2

# ---------- Core System Keybindings ----------
riverctl map normal Alt T spawn "foot"
riverctl map normal $MOD Return spawn "foot"
riverctl map normal $MOD C spawn "antigravity-ide"
riverctl map normal $MOD E spawn "thunar"
riverctl map normal $MOD W spawn "firefox"
riverctl map normal $MOD Space spawn "fuzzel"
riverctl map normal $MOD V spawn "rice-clipboard"
riverctl map normal $MOD M spawn "rice-taskmgr"
riverctl map normal $MOD Escape spawn "wlogout"
riverctl map normal $MOD Y spawn "rice-paper"
riverctl map normal $MOD N spawn "rice-notif"
riverctl map normal $MOD+Shift N spawn "geany"

# Rice Theme Selection binds
riverctl map normal $MOD+Control T spawn "rice-wallpaper next"
riverctl map normal $MOD+Control+Shift T spawn "rice-paper"
riverctl map normal $MOD+Control W spawn "rice-wallpaper next"
riverctl map normal $MOD+Control Y spawn "~/.config/waybar/scripts/theme-selector.sh"

# Security & Sessions
riverctl map normal $MOD+Alt L spawn "rice-lock"
riverctl map normal Control+Alt Delete spawn "rice-taskmgr"
riverctl map normal $MOD+Shift E exit  # Quit session safely

# ---------- Audio Controls (wpctl & playerctl) ----------
riverctl map normal None XF86AudioRaiseVolume spawn "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 3%+"
riverctl map normal None XF86AudioLowerVolume spawn "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 3%-"
riverctl map normal None XF86AudioMute spawn "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
riverctl map normal None XF86AudioMicMute spawn "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"

riverctl map normal None XF86AudioPause spawn "playerctl play-pause"
riverctl map normal None XF86AudioPlay spawn "playerctl play-pause"
riverctl map normal None XF86AudioPrev spawn "playerctl previous"
riverctl map normal None XF86AudioNext spawn "playerctl next"

riverctl map normal Control XF86AudioRaiseVolume spawn "playerctl volume 0.03+"
riverctl map normal Control XF86AudioLowerVolume spawn "playerctl volume 0.03-"

# ---------- Hardware Backlight Controls ----------
riverctl map normal None XF86MonBrightnessUp spawn "brightnessctl set 5%+"
riverctl map normal None XF86MonBrightnessDown spawn "brightnessctl set 5%-"

# ---------- Window Management & Navigation ----------
riverctl map normal $MOD Q close  # Close window
riverctl map normal $MOD F toggle-fullscreen  # Fullscreen toggle
riverctl map normal $MOD+Shift T toggle-float  # Floating mode toggle

# Directional Window Focus (Vim Style keys / Arrows)
riverctl map normal $MOD H focus-view left
riverctl map normal $MOD J focus-view down
riverctl map normal $MOD K focus-view up
riverctl map normal $MOD L focus-view right

riverctl map normal $MOD Left focus-view left
riverctl map normal $MOD Down focus-view down
riverctl map normal $MOD Up focus-view up
riverctl map normal $MOD Right focus-view right

# Directional Window Movement (Vim Style keys / Arrows)
riverctl map normal $MOD+Shift H swap left
riverctl map normal $MOD+Shift J swap down
riverctl map normal $MOD+Shift K swap up
riverctl map normal $MOD+Shift L swap right

riverctl map normal $MOD+Shift Left swap left
riverctl map normal $MOD+Shift Down swap down
riverctl map normal $MOD+Shift Up swap up
riverctl map normal $MOD+Shift Right swap right

# ---------- Workspaces / Tags ----------
for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))
    riverctl map normal $MOD "$i" set-focused-tags $tags
    riverctl map normal $MOD+Shift "$i" set-view-tags $tags
done

# ---------- Screenshot Mappings ----------
riverctl map normal None Print spawn "grim ~/Pictures/Screenshots/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
riverctl map normal $MOD Print spawn "grim -g \"$(slurp)\" ~/Pictures/Screenshots/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

# ---------- Autostart Core Daemons ----------
waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css &
mako &
wl-paste --type text --watch cliphist store &
rice-wallpaper random &

# Start the automatic BSP layout engine
river-bsp-layout &
riverctl default-layout bsp-layout

# Load the Matugen generated border colors on startup
[ -f ~/.config/river/river-colors.sh ] && bash ~/.config/river/river-colors.sh
